    "node": ">=20.17.0"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sqlite": "^4.1.2",
    "sqlite3": "^6.0.1"
  }
}
