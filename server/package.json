{
  "name": "le-wassa-api",
  "version": "1.0.0",
  "private": true,
  "description": "API Express du maquis-restaurant Le WASSA",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:dev": "node --watch index.js",
