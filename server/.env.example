# Exemple d'environnement pour le backend du maquis
PORT=5173
ADMIN_TOKEN=replace-with-at-least-32-random-characters
PUBLIC_SITE_URL=
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500
# DATABASE_URL vide = SQLite local. PostgreSQL est sélectionné lorsqu'une URL est fournie.
DATABASE_URL=
WASSA_DB_PATH=
WASSA_DATA_DIR=
# Gemini is optional; configure only on the backend host if used.
GEMINI_API_URL=https://api.gemini.example/v1/generate
GEMINI_API_KEY=your_api_key_here
# Never commit real credentials or replace these placeholders with production secrets.
